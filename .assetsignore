# Cloudflare Workers Assets — arquivos que NAO devem ser servidos publicamente.
# (assets.directory e "." no wrangler.jsonc, entao a raiz inteira seria exposta sem isto.)
# Sintaxe estilo .gitignore. Dotfiles (.env, .gitignore, etc.) o CF ja nao serve por padrao.

# Docs internos
*.md

# Codigo-fonte (o que vai pro ar e o js/*.min.js compilado, nao o .jsx)
*.jsx

# Scripts de build / prerender (rodam local, nao em producao)
*.ps1
scripts/
vendor/react-dom-server-legacy.browser.production.min.js

# Config / leftovers
vercel.json
wrangler.jsonc
*.bak
psi.json
lh.json
lh-post.json
